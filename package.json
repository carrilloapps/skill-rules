{
  "name": "skill-rules",
  "version": "0.2.0",
  "description": "Sync AI agent skills across Claude Code, Cursor, Windsurf and more — activate per-environment rule sets with one command",
  "type": "module",
  "bin": {
    "skill-rules": "./dist/index.js",
    "sr": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@inkjs/ui": "~2.0.0",
    "@modelcontextprotocol/sdk": "~1.29.0",
    "commander": "~12.1.0",
    "figures": "~6.1.0",
    "ink": "~5.2.1",
    "react": "~18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.0",
    "@vitest/coverage-v8": "~4.1.6",
    "esbuild": "~0.28.0",
    "eslint": "~9.39.0",
    "eslint-plugin-react": "~7.37.5",
    "globals": "~15.15.0",
    "prettier": "~3.8.3",
    "vitest": "~4.1.6"
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "node esbuild.config.js --watch",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "skills",
    "ai",
    "agents",
    "claude",
    "claude-code",
    "cursor",
    "windsurf",
    "copilot",
    "github-copilot",
    "cline",
    "openhands",
    "rules",
    "stages",
    "sync",
    "cli",
    "developer-tools"
  ],
  "author": {
    "name": "José Carrillo",
    "email": "m@carrillo.app",
    "url": "https://carrillo.app"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carrilloapps/skill-rules.git"
  },
  "homepage": "https://github.com/carrilloapps/skill-rules#readme",
  "bugs": {
    "url": "https://github.com/carrilloapps/skill-rules/issues"
  },
  "license": "MIT"
}
